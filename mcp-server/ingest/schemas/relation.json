{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claudsoul://schemas/relation",
  "title": "Relation (Extract output)",
  "type": "object",
  "required": ["relation_type", "from_entity", "to_entity", "sources"],
  "additionalProperties": false,
  "properties": {
    "relation_type": {
      "type": "string",
      "enum": [
        "role_in", "knows", "studied_at", "works_at", "part_of", "created",
        "participated_in", "similar_to", "contradicts", "caused_by", "applied_to",
        "mentions", "published_in"
      ]
    },
    "from_entity": {"type": "string", "minLength": 1},
    "to_entity": {"type": "string", "minLength": 1},
    "direction": {"type": "string", "enum": ["directed", "bidirectional"], "default": "directed"},
    "description": {"type": "string"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string"},
          "type": {
            "type": "string",
            "enum": ["self_report", "document", "third_party", "behavioral", "cross_reference"]
          },
          "extracted": {"type": "string"}
        }
      }
    },
    "valid_from": {"type": "string"},
    "valid_until": {"type": ["string", "null"]},
    "temporal_note": {"type": "string"},
    "domain": {"type": "array", "items": {"type": "string"}, "default": []},
    "tags": {"type": "array", "items": {"type": "string"}, "default": []},
    "edges": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": {"type": "string"}},
      "default": []
    }
  }
}
