{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claudsoul://schemas/extract_output",
  "title": "Extract output envelope (from /ingest skill)",
  "type": "object",
  "required": ["source_id", "entities", "facts", "relations"],
  "additionalProperties": false,
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "entities": {"type": "array", "items": {"$ref": "claudsoul://schemas/entity"}},
    "facts": {"type": "array", "items": {"$ref": "claudsoul://schemas/fact"}},
    "relations": {"type": "array", "items": {"$ref": "claudsoul://schemas/relation"}},
    "warnings": {"type": "array", "items": {"type": "string"}, "default": []}
  }
}
