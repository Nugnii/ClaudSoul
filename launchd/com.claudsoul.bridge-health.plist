<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claudsoul.bridge-health</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/.claude/hooks/bridge-health-digest.sh</string>
    </array>

    <!-- Monthly: first of month at 03:30 local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- Run once on load so first install seeds a digest immediately -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/.claude/hooks/state/bridge-health-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/hooks/state/bridge-health-stderr.log</string>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
