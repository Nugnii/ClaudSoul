<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claudsoul.scanner</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/.claude/hooks/auto-scanner.sh</string>
    </array>

    <!-- Every 4 hours (14400 seconds) -->
    <key>StartInterval</key>
    <integer>14400</integer>

    <!-- Also run on load (first scan immediately) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>__HOME__/.claude/hooks/state/scanner-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/hooks/state/scanner-stderr.log</string>

    <!-- Don't keep alive — just run on schedule -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
