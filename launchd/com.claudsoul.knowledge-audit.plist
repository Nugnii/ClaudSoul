<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claudsoul.knowledge-audit</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/.claude/hooks/knowledge-audit-digest.sh</string>
    </array>

    <!-- Weekly: every Sunday at 03:15 local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <!-- Run once on load so first install seeds a digest immediately -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/.claude/hooks/state/knowledge-audit-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/hooks/state/knowledge-audit-stderr.log</string>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
